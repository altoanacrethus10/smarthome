<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll_conversation_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="@dimen/spacing_m"
    android:paddingVertical="@dimen/spacing_s"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/iv_conversation_avatar"
        android:layout_width="@dimen/avatar_s"
        android:layout_height="@dimen/avatar_s"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_user" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/spacing_m"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_conversation_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="User Name"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_m"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_conversation_property"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxs"
            android:text="Property Name"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_xs"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_conversation_last_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxs"
            android:text="Last message preview"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_s"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_conversation_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_s"
        android:text="5m"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/text_xs" />

</LinearLayout>
