<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_m"
    app:cardCornerRadius="@dimen/radius_m"
    app:cardElevation="@dimen/elevation_s">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_property_image"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@color/gray_very_light"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_house_placeholder" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l">

            <TextView
                android:id="@+id/tv_property_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="@dimen/text_l"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_property_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textColor="@color/gray_medium"
                android:textSize="@dimen/text_s" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_property_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_m"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_property_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:background="@drawable/bg_status_success"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/success"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:minWidth="60dp"
                    android:gravity="center" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_property_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:textColor="@color/gray_dark"
                android:textSize="@dimen/text_s" />

            <TextView
                android:id="@+id/tv_property_metrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textColor="@color/gray_medium"
                android:textSize="@dimen/text_xs" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_view_property"
                    style="@style/Widget.SmartHome.Button.Dashboard.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="@string/view_details" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit_property"
                    style="@style/Widget.SmartHome.Button.Dashboard.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="2dp"
                    android:layout_weight="1"
                    android:text="@string/quick_edit" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_delete_property"
                    style="@style/Widget.SmartHome.Button.Dashboard.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="@string/quick_delete"
                    android:textColor="@color/error"
                    app:strokeColor="@color/error" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
