<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:titleTextColor="@color/white"
        app:title="@string/privacy_policy"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_m"
                app:cardElevation="@dimen/elevation_s">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_l">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Privacy Policy"
                        android:textSize="@dimen/text_xl"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_marginBottom="@dimen/spacing_m" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Last Updated: June 2026"
                        android:textSize="@dimen/text_s"
                        android:textColor="@color/gray_medium"
                        android:layout_marginBottom="@dimen/spacing_l" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1. Information We Collect"
                        android:textSize="@dimen/text_m"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_marginBottom="@dimen/spacing_xs" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SmartHome collects personal information that you provide to us, including your name, email address, phone number, and location. We also collect information about your housing preferences and search history."
                        android:textSize="@dimen/text_s"
                        android:textColor="@color/gray_dark"
                        android:layout_marginBottom="@dimen/spacing_m" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="2. How We Use Your Information"
                        android:textSize="@dimen/text_m"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_marginBottom="@dimen/spacing_xs" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="We use your information to:\n• Connect you with property owners and tenants\n• Personalize your experience\n• Send you notifications about new listings\n• Improve our services"
                        android:textSize="@dimen/text_s"
                        android:textColor="@color/gray_dark"
                        android:layout_marginBottom="@dimen/spacing_m" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="3. Data Security"
                        android:textSize="@dimen/text_m"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_marginBottom="@dimen/spacing_xs" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="We implement appropriate security measures to protect your personal information from unauthorized access, alteration, or disclosure."
                        android:textSize="@dimen/text_s"
                        android:textColor="@color/gray_dark"
                        android:layout_marginBottom="@dimen/spacing_m" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="4. Contact Us"
                        android:textSize="@dimen/text_m"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_marginBottom="@dimen/spacing_xs" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="If you have any questions about this Privacy Policy, please contact us at:\n📧 support@smarthome.com\n📞 +255 700 000 000"
                        android:textSize="@dimen/text_s"
                        android:textColor="@color/gray_dark" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>