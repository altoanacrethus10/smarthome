<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:titleTextColor="@color/white"
        app:title="Receipt"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Success Message -->
            <LinearLayout
                android:id="@+id/ll_success_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp"
                android:visibility="gone">
                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_check"
                    app:tint="@color/success" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Booking Confirmed!"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/success" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Your booking request has been sent."
                    android:textColor="@color/gray_medium" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_l"
                app:cardCornerRadius="@dimen/radius_m"
                app:cardElevation="@dimen/elevation_s">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_l">

                <!-- Receipt Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginTop="@dimen/spacing_s">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/ic_splash_logo"
                        app:tint="@color/primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SMARTHOME"
                        android:textSize="@dimen/text_l"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_marginTop="@dimen/spacing_xs" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rental Receipt"
                        android:textSize="@dimen/text_s"
                        android:textColor="@color/gray_medium" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/gray_very_light"
                    android:layout_marginVertical="@dimen/spacing_l" />

                <!-- Receipt Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Receipt #: "
                        android:textColor="@color/gray_medium" />

                    <TextView
                        android:id="@+id/tv_receipt_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RCP-2026-001"
                        android:textColor="@color/black"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Date: "
                        android:textColor="@color/gray_medium" />

                    <TextView
                        android:id="@+id/tv_receipt_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="June 27, 2026"
                        android:textColor="@color/black"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/gray_very_light"
                    android:layout_marginVertical="@dimen/spacing_l" />

                <!-- Tenant Info -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tenant Information"
                    android:textColor="@color/primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_tenant_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:text="Name: John Doe"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/tv_tenant_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="Phone: +255 700 000 000"
                    android:textColor="@color/gray_dark" />

                <!-- Property Info -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:text="Property Details"
                    android:textColor="@color/primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_property_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:text="Location: Kinondoni, Dar es Salaam"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/tv_property_details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="3 Bedrooms, 2 Bathrooms"
                    android:textColor="@color/gray_dark" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/gray_very_light"
                    android:layout_marginVertical="@dimen/spacing_l" />

                <!-- Payment Summary -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Payment Summary"
                    android:textColor="@color/primary"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_s"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Monthly Rent"
                        android:textColor="@color/gray_dark" />

                    <TextView
                        android:id="@+id/tv_rent_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tsh 350,000"
                        android:textColor="@color/black" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Security Deposit"
                        android:textColor="@color/gray_dark" />

                    <TextView
                        android:id="@+id/tv_deposit_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tsh 350,000"
                        android:textColor="@color/black" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/gray_very_light"
                    android:layout_marginTop="@dimen/spacing_l"
                    android:layout_marginBottom="@dimen/spacing_m" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total Paid"
                        android:textSize="@dimen/text_m"
                        android:textStyle="bold"
                        android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/tv_total_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tsh 700,000"
                        android:textSize="@dimen/text_m"
                        android:textStyle="bold"
                        android:textColor="@color/primary" />
                </LinearLayout>

                <!-- Footer -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:gravity="center"
                    android:text="Thank you for choosing SmartHome!"
                    android:textColor="@color/gray_medium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:gravity="center"
                    android:text="This is a computer-generated receipt."
                    android:textSize="@dimen/text_xs"
                    android:textColor="@color/gray_light" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_share_receipt"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height_l"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:text="Share"
                    android:textAllCaps="false"
                    style="@style/Widget.SmartHome.Button.Outlined"
                    app:icon="@drawable/ic_share" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_print_receipt"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height_l"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:text="Print"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_check"
                    app:cornerRadius="@dimen/radius_m" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_bluetooth_receipt"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_l"
                android:layout_marginTop="@dimen/spacing_s"
                android:text="Share via Bluetooth"
                android:textAllCaps="false"
                style="@style/Widget.SmartHome.Button.Outlined"
                app:icon="@drawable/ic_share" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_view_my_bookings"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_l"
                android:layout_marginTop="@dimen/spacing_s"
                android:text="View My Bookings"
                android:textAllCaps="false"
                android:visibility="gone"
                app:icon="@drawable/ic_dashboard"
                app:cornerRadius="@dimen/radius_m" />

        </LinearLayout>

    </LinearLayout>

    </ScrollView>

</LinearLayout>
