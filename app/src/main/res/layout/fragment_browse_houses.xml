<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:windowBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_l"
        android:paddingTop="@dimen/spacing_l"
        android:paddingBottom="@dimen/spacing_xl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Browse homes"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_xl"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="Find available rentals by area, budget, and bedrooms."
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_s" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            app:cardCornerRadius="@dimen/radius_m"
            app:cardElevation="0dp"
            app:strokeColor="@color/outline_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_m"
                android:paddingEnd="@dimen/spacing_s">

                <ImageView
                    android:layout_width="@dimen/icon_m"
                    android:layout_height="@dimen/icon_m"
                    android:src="@drawable/ic_search"
                    app:tint="@color/gray_medium" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/spacing_s"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Search area or house type"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="@color/gray_medium"
                    android:textSize="@dimen/text_s" />

                <ImageButton
                    android:id="@+id/iv_search"
                    android:layout_width="@dimen/button_height_m"
                    android:layout_height="@dimen/button_height_m"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/search"
                    android:padding="12dp"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/spinner_location"
                    android:layout_width="148dp"
                    android:layout_height="@dimen/button_height_m"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:background="@drawable/bg_input_outline"
                    android:entries="@array/locations"
                    android:paddingHorizontal="@dimen/spacing_s" />

                <Spinner
                    android:id="@+id/spinner_price"
                    android:layout_width="148dp"
                    android:layout_height="@dimen/button_height_m"
                    android:layout_marginEnd="@dimen/spacing_s"
                    android:background="@drawable/bg_input_outline"
                    android:entries="@array/price_ranges"
                    android:paddingHorizontal="@dimen/spacing_s" />

                <Spinner
                    android:id="@+id/spinner_bedrooms"
                    android:layout_width="128dp"
                    android:layout_height="@dimen/button_height_m"
                    android:background="@drawable/bg_input_outline"
                    android:entries="@array/bedroom_counts"
                    android:paddingHorizontal="@dimen/spacing_s" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            android:layout_marginBottom="@dimen/spacing_s"
            android:text="Available houses"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_l"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_houses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
