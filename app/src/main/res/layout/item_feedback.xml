<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_s"
    app:cardCornerRadius="@dimen/radius_m"
    app:cardElevation="@dimen/elevation_s">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_l">

        <!-- User and Rating -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_feedback_user"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="John Doe"
                android:textSize="@dimen/text_m"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/tv_rating_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Excellent"
                android:textSize="@dimen/text_s"
                android:textColor="@color/success" />
        </LinearLayout>

        <!-- Rating Bar -->
        <RatingBar
            android:id="@+id/rb_feedback_display"
            style="@style/CustomRatingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:isIndicator="true" />

        <!-- Feedback Type -->
        <TextView
            android:id="@+id/tv_feedback_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:text="General Feedback"
            android:textSize="@dimen/text_s"
            android:textColor="@color/accent"
            android:background="@drawable/bg_status_info"
            android:paddingStart="@dimen/spacing_m"
            android:paddingEnd="@dimen/spacing_m"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingBottom="@dimen/spacing_xs" />

        <!-- House Title -->
        <TextView
            android:id="@+id/tv_feedback_house"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:text="Property: Modern House"
            android:textSize="@dimen/text_s"
            android:textColor="@color/gray_medium" />

        <!-- Message -->
        <TextView
            android:id="@+id/tv_feedback_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:text="Great app! Found my dream house easily."
            android:textSize="@dimen/text_s"
            android:textColor="@color/gray_dark" />

        <!-- Date -->
        <TextView
            android:id="@+id/tv_feedback_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:text="15 Jun 2026"
            android:textSize="@dimen/text_xs"
            android:textColor="@color/gray_light"
            android:layout_gravity="end" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>