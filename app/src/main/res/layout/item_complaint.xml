<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_s"
    app:cardCornerRadius="@dimen/radius_m"
    app:cardElevation="@dimen/elevation_s">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_l">

        <!-- Subject and Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_complaint_subject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Issue with landlord"
                android:textSize="@dimen/text_m"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/tv_complaint_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending"
                android:textSize="@dimen/text_s"
                android:paddingStart="@dimen/spacing_m"
                android:paddingEnd="@dimen/spacing_m"
                android:paddingTop="@dimen/spacing_xs"
                android:paddingBottom="@dimen/spacing_xs"
                android:background="@drawable/bg_status_warning" />
        </LinearLayout>

        <!-- Category -->
        <TextView
            android:id="@+id/tv_complaint_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:text="Landlord Issue"
            android:textSize="@dimen/text_s"
            android:textColor="@color/gray_medium" />

        <!-- Description -->
        <TextView
            android:id="@+id/tv_complaint_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:text="The landlord refused to fix the leaking roof..."
            android:textSize="@dimen/text_s"
            android:textColor="@color/gray_dark" />

        <!-- Response -->
        <TextView
            android:id="@+id/tv_complaint_response"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:text="Response: We are looking into this issue."
            android:textSize="@dimen/text_s"
            android:textColor="@color/accent"
            android:background="@drawable/bg_status_info"
            android:padding="@dimen/spacing_s"
            android:visibility="gone" />

        <!-- Date -->
        <TextView
            android:id="@+id/tv_complaint_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:text="15 Jun 2026, 14:30"
            android:textSize="@dimen/text_xs"
            android:textColor="@color/gray_light"
            android:layout_gravity="end" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>