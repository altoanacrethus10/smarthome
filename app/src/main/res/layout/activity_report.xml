<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:windowBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/white"
        app:title="Booking Report"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="40dp"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/report_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SmartHome Booking Report"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_xl"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_report_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="Date and time"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_s" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_l"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total Bookings"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tv_report_total_bookings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_l"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:text="Total Rent Amount"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tv_report_total_rent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tsh 0"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_l"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:text="Total Deposit Amount"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tv_report_total_deposit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tsh 0"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_l"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="Receipt/Booking History"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_m"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_report_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:background="@drawable/bg_card_rounded"
                android:backgroundTint="?attr/colorSurfaceVariant"
                android:padding="@dimen/spacing_m"
                android:text="Loading..."
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_s" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share_report"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_l"
                android:layout_marginTop="@dimen/spacing_l"
                android:text="Share Report"
                android:textAllCaps="false"
                app:cornerRadius="@dimen/radius_m"
                app:icon="@drawable/ic_share" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_bluetooth_report"
                style="@style/Widget.SmartHome.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_l"
                android:layout_marginTop="@dimen/spacing_s"
                android:text="Share via Bluetooth"
                android:textAllCaps="false"
                app:icon="@drawable/ic_share" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
