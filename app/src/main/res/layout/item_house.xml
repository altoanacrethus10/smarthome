<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_s"
    android:layout_marginBottom="@dimen/spacing_m"
    app:cardCornerRadius="@dimen/radius_m"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/outline_variant">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Visual Content -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="200dp">

            <ImageView
                android:id="@+id/iv_house_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_house_placeholder"
                android:background="@color/gray_very_light" />

            <!-- Status Overlay -->
            <TextView
                android:id="@+id/tv_house_available"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true"
                android:layout_margin="16dp"
                android:background="@drawable/bg_status_success"
                android:backgroundTint="#AA059669"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Available"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textAllCaps="true" />

            <ImageButton
                android:id="@+id/btn_favorite"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_margin="16dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="#CCFFFFFF"
                android:contentDescription="@string/saved_favorites"
                android:src="@drawable/ic_favorite_border"
                app:tint="@color/error"
                android:padding="8dp" />

            <!-- Price Badge on Image -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_alignParentStart="true"
                android:layout_margin="16dp"
                android:background="@drawable/bg_card_rounded"
                android:backgroundTint="#EEFFFFFF"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <TextView
                    android:id="@+id/tv_house_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tsh 450,000"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="/mo"
                    android:textColor="@color/gray_medium"
                    android:textSize="10sp" />
            </LinearLayout>

        </RelativeLayout>

        <!-- Listing Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_m">

            <TextView
                android:id="@+id/tv_house_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Executive 3 Bedroom Apartment"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_m"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_house_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Mbezi Beach, Dar es Salaam"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_xs"
                app:drawableStartCompat="@drawable/ic_location"
                app:drawableTint="@color/gray_medium"
                android:drawablePadding="6dp" />

            <TextView
                android:id="@+id/tv_house_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Apartment"
                android:textColor="@color/primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/tv_house_distance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Near you"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:visibility="gone" />

            <!-- Specs Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_m"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_house_bedrooms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:text="3 Bed"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:drawableStartCompat="@drawable/ic_bed"
                    app:drawableTint="@color/gray_medium"
                    android:drawablePadding="6dp" />

                <TextView
                    android:id="@+id/tv_house_bathrooms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:text="2 Bath"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:drawableStartCompat="@drawable/ic_bath"
                    app:drawableTint="@color/gray_medium"
                    android:drawablePadding="6dp" />

                <TextView
                    android:id="@+id/tv_house_area"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="150 m²"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:drawableStartCompat="@drawable/ic_area"
                    app:drawableTint="@color/gray_medium"
                    android:drawablePadding="6dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_view_details"
                    style="@style/Widget.SmartHome.Button.Dashboard.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/view_details"
                    android:textColor="@color/primary"
                    app:strokeColor="@color/primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save_property"
                    style="@style/Widget.SmartHome.Button.Dashboard.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="Save"
                    android:textColor="@color/error"
                    app:strokeColor="@color/error" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_contact_owner"
                    style="@style/Widget.SmartHome.Button.Dashboard.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="Contact"
                    android:textColor="@color/success"
                    app:strokeColor="@color/success" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
